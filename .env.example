EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth client IDs (public — safe in the client bundle).
# Web client ID is used by signInWithIdToken; iOS client ID by the native flow.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Local Supabase Google provider (supabase/config.toml reads these from env).
# CLIENT_ID = "<web-client-id>,<ios-client-id>" (web first). SECRET = web client secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
