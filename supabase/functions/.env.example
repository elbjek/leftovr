# Copy to supabase/functions/.env (gitignored) for local `supabase functions serve`.
# Hosted: supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_API_KEY=

# RevenueCat webhook shared secret. Must equal the "Authorization header value"
# set in the RevenueCat dashboard webhook config.
# Hosted: supabase secrets set REVENUECAT_WEBHOOK_SECRET=...
REVENUECAT_WEBHOOK_SECRET=